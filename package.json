{
  "name": "cajui",
  "version": "0.2.1",
  "description": "Bootstrap your Point of Sale frontend in minutes. React components built for POS & ERP.",
  "keywords": [
    "react",
    "pos",
    "point-of-sale",
    "erp",
    "tailwind",
    "components",
    "caja",
    "punto-de-venta"
  ],
  "license": "MIT",
  "author": "cajui contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/raganaxi/cajui"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/cajui.umd.cjs",
  "module": "./dist/cajui.js",
  "exports": {
    ".": {
      "import": "./dist/cajui.js",
      "require": "./dist/cajui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "lsof -t -i:6006 | xargs kill -9 2>/dev/null || true; storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:storybook": "storybook build",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.4.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0"
  }
}
